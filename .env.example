# ---------------------------------------------------------------------------
# Mock mode
#
# With this on, the app never calls DocuSign and the whole signing flow still
# works end to end. None of the DOCUSIGN_* values below are needed.
# Start here to see how the flow behaves.
# ---------------------------------------------------------------------------
DOCUSIGN_MOCK=true

# ---------------------------------------------------------------------------
# Real DocuSign (set DOCUSIGN_MOCK=false)
#
# See docs/docusign-setup.md for how to obtain these.
# A free developer account is enough.
# ---------------------------------------------------------------------------

# Integration Key, i.e. the OAuth client_id. Issued under Apps and Keys.
# DOCUSIGN_INTEGRATION_KEY=00000000-0000-0000-0000-000000000000

# API Account ID, shown at the top of the Apps and Keys page.
# DOCUSIGN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# User ID (API Username) of the user being impersonated.
# DOCUSIGN_USER_ID=00000000-0000-0000-0000-000000000000

# RSA private key, Base64-encoded so it fits on one line:
#   base64 -w0 private.key
# DOCUSIGN_PRIVATE_KEY_BASE64=

# Defaults below target the developer sandbox. For production accounts use
#   DOCUSIGN_OAUTH_BASE_URL=account.docusign.com
#   DOCUSIGN_API_HOST=https://www.docusign.net
# DOCUSIGN_OAUTH_BASE_URL=account-d.docusign.com
# DOCUSIGN_API_HOST=https://demo.docusign.net
